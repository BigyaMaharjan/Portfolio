{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "967d2fae-ffa7-46a9-9534-51422610985f"
  },
  "newProjectRoot": "projects",
  "projects": {
    "portfolio-site": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:component": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/files",
                "output": "files"
              },
              {
                "glob": "csharp-original.svg",
                "input": "node_modules/devicon/icons/csharp",
                "output": "tech-icons"
              },
              {
                "glob": "dot-net-original.svg",
                "input": "node_modules/devicon/icons/dot-net",
                "output": "tech-icons"
              },
              {
                "glob": "entityframeworkcore-original.svg",
                "input": "node_modules/devicon/icons/entityframeworkcore",
                "output": "tech-icons"
              },
              {
                "glob": "apachekafka-original.svg",
                "input": "node_modules/devicon/icons/apachekafka",
                "output": "tech-icons"
              },
              {
                "glob": "postgresql-original.svg",
                "input": "node_modules/devicon/icons/postgresql",
                "output": "tech-icons"
              },
              {
                "glob": "microsoftsqlserver-original.svg",
                "input": "node_modules/devicon/icons/microsoftsqlserver",
                "output": "tech-icons"
              },
              {
                "glob": "docker-original.svg",
                "input": "node_modules/devicon/icons/docker",
                "output": "tech-icons"
              },
              {
                "glob": "jenkins-original.svg",
                "input": "node_modules/devicon/icons/jenkins",
                "output": "tech-icons"
              },
              {
                "glob": "git-original.svg",
                "input": "node_modules/devicon/icons/git",
                "output": "tech-icons"
              },
              {
                "glob": "angular-original.svg",
                "input": "node_modules/devicon/icons/angular",
                "output": "tech-icons"
              },
              {
                "glob": "google-original.svg",
                "input": "node_modules/devicon/icons/google",
                "output": "tech-icons"
              }
            ],
            "styles": [
              "src/vendor/scrollcraft/scrollcraft.css",
              "src/styles.css"
            ],
            "scripts": [
              "src/vendor/scrollcraft/scrollcraft.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "24kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "portfolio-site:build:production"
            },
            "development": {
              "buildTarget": "portfolio-site:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
